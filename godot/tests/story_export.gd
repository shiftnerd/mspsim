extends SceneTree
# gdlint:disable=max-line-length
# Story tools. Run from the project folder:
#   Godot --headless --path godot -s res://tests/story_export.gd -- --init    write story/strings.txt from the game's defaults (only if it does not exist)
#   Godot --headless --path godot -s res://tests/story_export.gd -- --sync    refresh story/strings.txt after code changes (keeps edits, adds new strings)
#   Godot --headless --path godot -s res://tests/story_export.gd -- --doc     write the readable story bible story/STORY.md (from the text as the game uses it now)
#   Godot --headless --path godot -s res://tests/story_export.gd -- --check   list problems in story/strings.txt (unknown keys, changed placeholders, 2013-14 slips)

const DOC := "res://story/STORY.md"

var md := PackedStringArray()


func _initialize() -> void:
	await process_frame
	var strings := root.get_node("Strings")
	var args := OS.get_cmdline_user_args()
	if args.has("--init"):
		if FileAccess.file_exists(strings.FILE):
			print("story/strings.txt already exists: use --sync to refresh it")
		else:
			_write(strings.FILE, strings.build({}))
			print("wrote ", strings.FILE)
	if args.has("--sync"):
		var existing: Dictionary = {}
		if FileAccess.file_exists(strings.FILE):
			existing = strings.parse(FileAccess.get_file_as_string(strings.FILE))
		_write(strings.FILE, strings.build(existing))
		print("synced ", strings.FILE, " (", existing.size(), " entries kept)")
	if args.has("--doc"):
		_build_doc(strings)
		_write(DOC, "\n".join(md))
		print("wrote ", DOC)
	if args.has("--check"):
		print("applied %d edited strings" % strings.applied)
		for line in strings.report:
			print(line)
		if strings.report.is_empty():
			print("no problems found")
	quit()


func _write(path: String, text: String) -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://story"))
	var f := FileAccess.open(path, FileAccess.WRITE)
	f.store_string(text)
	f.close()


# ---- the readable story bible ----------------------------------------------------------------------
func _k(parts: Array) -> String:
	return (
		"`[%s]`" % ".".join(PackedStringArray(parts.map(func(p: Variant) -> String: return str(p))))
	)


func _clock(hours: float) -> String:
	var h := int(hours)
	return "%d:%02d" % [h, int((hours - float(h)) * 60.0)]


func _quote(text: String) -> String:
	return "> " + text.replace("%s", "[name]").replace("%d", "[number]")


func _build_doc(_strings: Node) -> void:
	var story := root.get_node("Story")
	var playbook := root.get_node("Playbook")
	var owner := root.get_node("Owner")
	md.append("# MSPSim story bible")
	md.append("")
	(
		md
		. append(
			"Generated from the game by `tests/story_export.gd --doc`; do not edit this file. To change the story edit `story/strings.txt`"
		)
	)
	(
		md
		. append(
			"(see `README.md`). Each line of text below ends with its `[key]` so a suggestion can say exactly which line it means."
		)
	)
	md.append("Placeholders like [name] are filled in by the game.")
	md.append("")
	(
		md
		. append(
			"The game is a 2013-14 pixel-art office sim about a managed service provider (an MSP): you are a service-desk tech (tech campaign, 20 days)"
		)
	)
	md.append("or the owner (owner campaign, 20 weeks).")
	md.append("")
	md.append("## 1. Tech campaign, day by day")
	md.append("")
	_tech_days(story, playbook)
	md.append("## 2. The big jobs")
	md.append("")
	_jobs(playbook)
	md.append("## 3. Owner campaign, week by week")
	md.append("")
	_owner(owner)
	md.append("## 4. Coworkers talk")
	md.append("")
	_dialogue()
	md.append("## 5. Tickets, the forum and instant messages")
	md.append("")
	_misc()
	md.append("## 6. Endings and reviews")
	md.append("")
	_endings()


func _tech_days(story: Node, playbook: Node) -> void:
	var days: Dictionary = story.DAYS
	var keys := days.keys()
	keys.sort()
	var extra := {
		"backup_break":
		"A client's nightly backup quietly starts failing (the player only finds out by checking).",
		"ransomware":
		"CryptoLocker hits the law firm's server. With a good backup it is a rescue; without one it is a disaster.",
		"adobe": "An easy ticket: Adobe Reader will not print.",
		"install": "The Windows XP desktop replacement and migration job at the dental office.",
		"install_followup": "If the install lost data, the client writes back.",
		"growth_plan":
		"Morgan sets up the Tier 1 to Tier 2 growth plan (pick a skill and a helper).",
		"growth_block": "30 protected training minutes.",
		"growth_stretch": "A stretch ticket with a helper nearby.",
		"callback_install": "The desktop install comes back: the client reacts to how it went.",
		"callback_ransom": "The law firm reacts to how the ransomware went.",
		"callback_worst": "Morgan brings up the player's worst job before the review.",
	}
	for day in keys:
		md.append("### Day %s" % str(day))
		md.append("")
		var events: Array = days[day]
		var order := range(events.size())
		order.sort_custom(
			func(a: int, b: int) -> bool: return float(events[a].at) < float(events[b].at)
		)
		for i in order:
			var ev: Dictionary = events[i]
			var kind := str(ev.kind)
			var head := "**%s %s**" % [_clock(float(ev.at)), kind.to_upper().replace("_", " ")]
			match kind:
				"mail":
					md.append(
						(
							"%s, from %s. Subject: *%s* %s"
							% [
								head,
								str(ev.from),
								str(ev.subject),
								_k(["Story", "DAYS", day, i, "subject"])
							]
						)
					)
					md.append(_quote(str(ev.body)) + " " + _k(["Story", "DAYS", day, i, "body"]))
				"text", "playbook":
					var label := (
						"Morgan texts"
						if kind == "playbook"
						else "Text from %s" % str(ev.get("from", "the boss"))
					)
					var job := ""
					if kind == "playbook":
						var book: Dictionary = playbook.BOOKS.get(str(ev.get("book", "")), {})
						job = (
							" The job starts: **%s**."
							% str(book.get("title", ev.get("book", ""))).capitalize()
						)
					md.append("%s. %s%s" % [head, label, job])
					md.append(
						(
							_quote(str(ev.get("text", ev.get("body", ""))))
							+ " "
							+ _k(["Story", "DAYS", day, i, "text" if ev.has("text") else "body"])
						)
					)
				_:
					md.append(
						"%s. %s" % [head, str(extra.get(kind, "A scripted event (%s)." % kind))]
					)
			md.append("")
		var notes := []
		if root.get_node("Shift").on_call(int(day)):
			notes.append("on call tonight")
		if root.get_node("Meeting").MEETING_DAYS.has(int(day)):
			notes.append("all-hands at 14:00")
		if root.get_node("Outings").TECH_DAYS.has(int(day)):
			notes.append("team outing invitation at 16:00")
		if not notes.is_empty():
			md.append(
				(
					"*Every day also has: a morning commute, random tickets, coworker chat. Today: "
					+ ", ".join(notes)
					+ ".*"
				)
			)
			md.append("")


func _jobs(playbook: Node) -> void:
	var books: Dictionary = playbook.BOOKS
	for id in books:
		var book: Dictionary = books[id]
		md.append("### %s" % str(book.title).capitalize())
		md.append("")
		var tickets: Array = playbook.PROBLEMS.get(id, [])
		for i in tickets.size():
			md.append(
				(
					"- Ticket: *%s* %s"
					% [str(tickets[i].summary), _k(["Playbook", "PROBLEMS", id, i, "summary"])]
				)
			)
			md.append(
				(
					"  "
					+ _quote(str(tickets[i].body))
					+ " "
					+ _k(["Playbook", "PROBLEMS", id, i, "body"])
				)
			)
		md.append("")
		var steps: Array = book.steps
		for s in steps.size():
			var step: Dictionary = steps[s]
			md.append(
				(
					"**Step %d: %s** %s"
					% [s + 1, str(step.title), _k(["Playbook", "BOOKS", id, "steps", s, "title"])]
				)
			)
			md.append(
				_quote(str(step.text)) + " " + _k(["Playbook", "BOOKS", id, "steps", s, "text"])
			)
			var choices: Array = step.choices
			for c in choices.size():
				var ch: Dictionary = choices[c]
				var bits := ["%d points" % int(ch.get("pts", 0))]
				if ch.has("req"):
					bits.append("needs %s level %d" % [str(ch.req[0]), int(ch.req[1])])
				if ch.has("needs"):
					bits.append("needs earlier: %s" % str(ch.needs))
				if ch.has("flag"):
					bits.append("remembers: %s" % str(ch.flag))
				md.append(
					(
						"- **%s** %s (%s)"
						% [
							str(ch.label),
							_k(["Playbook", "BOOKS", id, "steps", s, "choices", c, "label"]),
							", ".join(bits)
						]
					)
				)
				if ch.has("note"):
					md.append(
						(
							"  - Result: "
							+ str(ch.note)
							+ " "
							+ _k(["Playbook", "BOOKS", id, "steps", s, "choices", c, "note"])
						)
					)
			md.append("")


func _owner(owner: Node) -> void:
	var weeks: Dictionary = owner.DAYS
	var keys := weeks.keys()
	keys.sort()
	for week in keys:
		md.append("### Week %s" % str(week))
		md.append("")
		var events: Array = weeks[week]
		for ev in events:
			var at := _clock(float(ev.at))
			if ev.has("card"):
				_card(owner, str(ev.card), at)
			else:
				md.append(
					(
						"**%s** Event: %s (handled in code, it opens its own cards)"
						% [at, str(ev.get("event", "?"))]
					)
				)
				md.append("")


func _card(owner: Node, id: String, at: String) -> void:
	var card: Dictionary = owner.CARDS.get(id, {})
	if card.is_empty():
		return
	md.append(
		(
			"**%s Card: %s** — %s %s"
			% [at, id, str(card.speaker), _k(["Owner", "CARDS", id, "speaker"])]
		)
	)
	md.append(_quote(str(card.text)) + " " + _k(["Owner", "CARDS", id, "text"]))
	var options: Array = card.options
	for i in options.size():
		var opt: Dictionary = options[i]
		md.append(
			"- **%s** %s" % [str(opt.label), _k(["Owner", "CARDS", id, "options", i, "label"])]
		)
		if opt.has("text"):
			md.append(
				"  - " + str(opt.text) + " " + _k(["Owner", "CARDS", id, "options", i, "text"])
			)
		if opt.has("roll"):
			var rolls: Array = opt.roll
			for r in rolls.size():
				md.append(
					(
						"  - %d%%: %s %s"
						% [
							int(float(rolls[r][0]) * 100.0),
							str(rolls[r][2]),
							_k(["Owner", "CARDS", id, "options", i, "roll", r, 2])
						]
					)
				)
	md.append("")


func _dialogue() -> void:
	var talk := root.get_node("Talk")
	for who in talk.GREETINGS:
		md.append("### %s" % str(who))
		md.append("")
		for tier in talk.GREETINGS[who]:
			md.append(
				(
					"- Greeting (%s): %s %s"
					% [
						str(tier),
						str(talk.GREETINGS[who][tier]),
						_k(["Talk", "GREETINGS", who, tier])
					]
				)
			)
		var lines: Array = talk.SMALL[who]
		for i in lines.size():
			md.append("- Small talk: %s %s" % [str(lines[i]), _k(["Talk", "SMALL", who, i])])
		var tips: Array = talk.TIPS_GENERIC[who]
		for i in tips.size():
			md.append("- Tip: %s %s" % [str(tips[i]), _k(["Talk", "TIPS_GENERIC", who, i])])
		md.append("")
	md.append("### Gossip (anyone, now and then)")
	md.append("")
	var gossip: Array = talk.GOSSIP
	for i in gossip.size():
		md.append("- %s %s" % [str(gossip[i]), _k(["Talk", "GOSSIP", i])])
	md.append("")


func _misc() -> void:
	var msp := root.get_node("Msp")
	md.append("### Random help-desk tickets")
	md.append("")
	var problems: Array = msp.PROBLEMS
	for i in problems.size():
		md.append(
			(
				"- *%s* %s: %s %s"
				% [
					str(problems[i].summary),
					_k(["Msp", "PROBLEMS", i, "summary"]),
					str(problems[i].body),
					_k(["Msp", "PROBLEMS", i, "body"])
				]
			)
		)
	md.append("")
	md.append("### LabRat Nerds forum threads")
	md.append("")
	var threads: Array = root.get_node("Nerds").THREADS
	for i in threads.size():
		md.append("- %s %s" % [str(threads[i].title), _k(["Nerds", "THREADS", i, "title"])])
	md.append("")
	md.append("### LabRat Nerds regulars at Rodent Nation (the forum people in the crowd)")
	md.append("")
	var forum: Array = root.get_node("Expo").FORUM
	for i in forum.size():
		md.append("- **%s** %s" % [str(forum[i].speaker), _k(["Expo", "FORUM", i, "speaker"])])
		md.append("  - " + str(forum[i].text) + " " + _k(["Expo", "FORUM", i, "text"]))
		for j in forum[i].options.size():
			var o: Dictionary = forum[i].options[j]
			md.append(
				(
					"  - **%s** %s: %s %s"
					% [
						str(o.label),
						_k(["Expo", "FORUM", i, "options", j, "label"]),
						str(o.text),
						_k(["Expo", "FORUM", i, "options", j, "text"])
					]
				)
			)
	md.append("")
	md.append("### Instant messages from coworkers (Lync)")
	md.append("")
	var messages: Dictionary = root.get_node("Lync").MESSAGES
	for id in messages:
		md.append(
			(
				"- **%s**: %s %s"
				% [str(id), str(messages[id].text), _k(["Lync", "MESSAGES", id, "text"])]
			)
		)
		var opts: Array = messages[id].options
		for i in opts.size():
			md.append(
				"  - You say: %s -> they reply: %s" % [str(opts[i].label), str(opts[i].reply)]
			)
	md.append("")
	md.append("### Commute and on-call")
	md.append("")
	var shift := root.get_node("Shift")
	var reasons: Array = shift.REASONS
	for i in reasons.size():
		md.append("- Late because of: %s %s" % [str(reasons[i]), _k(["Shift", "REASONS", i])])
	var pages: Array = shift.PAGES
	for i in pages.size():
		md.append("- The pager at 2 AM: %s %s" % [str(pages[i]), _k(["Shift", "PAGES", i])])
	md.append("")
	md.append("### Day-1 control hints")
	md.append("")
	var hints: Array = root.get_node("Hints").DAY1
	for i in hints.size():
		md.append("- %s %s" % [str(hints[i].text), _k(["Hints", "DAY1", i, "text"])])
	md.append("")


func _endings() -> void:
	var review := root.get_node("Review")
	md.append("### What your coworkers say about you (by how they feel)")
	md.append("")
	for mood in review.QUOTES:
		md.append(
			"- %s: %s %s" % [str(mood), str(review.QUOTES[mood]), _k(["Review", "QUOTES", mood])]
		)
	md.append("")
	md.append("### What the owners (Alan, Garrison) say about you")
	md.append("")
	for mood in review.OWNER_QUOTES:
		md.append(
			(
				"- %s: %s %s"
				% [
					str(mood),
					str(review.OWNER_QUOTES[mood]),
					_k(["Review", "OWNER_QUOTES", mood])
				]
			)
		)
	md.append("")
	md.append("### Epilogues")
	md.append("")
	for id in review.EPILOGUES:
		md.append(
			(
				"- **%s**: %s %s"
				% [str(id), str(review.EPILOGUES[id]), _k(["Review", "EPILOGUES", id])]
			)
		)
	md.append("")
